# PostgreSQL runtime connection used by the Next.js application.
DATABASE_URL=

# Direct PostgreSQL connection used only by migration and database-check scripts.
DIRECT_URL=

# Brawl Stars developer API key. Never expose this value to browser code.
BRAWL_STARS_API_KEY=

# Required. Use only the official API or a proxy that you explicitly trust.
BRAWL_STARS_API_BASE_URL=

# Optional owned-skin auxiliary lookup. Disabled by default until provider terms are reviewed.
BRAWLACE_SKIN_LOOKUP_ENABLED=false

# Optional reader fallback. Requires the direct Brawlace lookup above and is also disabled by default.
# Enable only after reviewing Jina Reader and target-site terms.
BRAWLACE_JINA_READER_ENABLED=false
JINA_READER_API_KEY=

# Optional Google AdSense configuration. Leave blank for local development.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# Optional account feature gate. Keep off until owner policies and Google OAuth are ready.
ACCOUNTS_MODE=off
# Emergency rollback only. Keep 0 during normal pre-launch/off operation; set to 1
# only when existing users must retain the deletion-only flow while accounts are off.
ACCOUNT_DELETION_ONLY=0
# Private PB sync has a separate server-side kill switch.
ACCOUNT_SYNC_ENABLED=0
# Public application origin only; never derive this from the incoming Host header.
# Google callback path is /api/auth/callback/google.
BETTER_AUTH_URL=
# Random server secret of at least 32 characters. Never expose it to client code.
BETTER_AUTH_SECRET=
# Google OAuth web client credentials. Register only exact local/staging/prod callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated exact trusted origins; wildcards and PR previews are not allowed.
ACCOUNT_TRUSTED_ORIGINS=
# Space/comma-separated Google subject (sub) allowlist used only in ACCOUNTS_MODE=pilot.
GOOGLE_PILOT_SUBJECT_ALLOWLIST=
# Separate random HMAC key, at least 32 characters, for shared account rate-limit subjects.
ACCOUNT_RATE_LIMIT_SECRET=
# Approved, versioned user-facing policy identifiers. Account feature stays closed if missing.
ACCOUNT_TERMS_VERSION=
ACCOUNT_PRIVACY_NOTICE_VERSION=
ACCOUNT_ELIGIBILITY_POLICY_VERSION=
# JSON object with one non-empty eligibility notice for each supported locale.
ACCOUNT_ELIGIBILITY_POLICY_TEXTS_JSON=
# Structured, owner-approved account eligibility rules. The app stores only the
# user's attestation, not DOB/region. Example shape:
# {"minimumAge":18,"regions":"all","guardianConsent":"not-supported","attestation":"self"}
ACCOUNT_ELIGIBILITY_RULES_JSON=
# Version of the owner-approved backup retention/deletion-manifest policy.
ACCOUNT_BACKUP_RETENTION_POLICY_VERSION=
# Backups and signed deletion manifests use explicit retention windows. The
# deletion-manifest window must be longer than the backup window.
ACCOUNT_BACKUP_RETENTION_DAYS=
ACCOUNT_DELETION_MANIFEST_RETENTION_DAYS=
# Separate HMAC secret (32+ chars) used to authenticate deletion manifests.
ACCOUNT_DELETION_MANIFEST_SECRET=
# Explicit read target used only by db:deletions:export. This helper never falls
# back to DATABASE_URL or DIRECT_URL.
ACCOUNT_DELETION_EXPORT_DATABASE_URL=
# Vercel Cron bearer secret; cleanup endpoint fails closed when unset or too short.
CRON_SECRET=

# Dedicated isolated target for scripts/migrate-accounts.mjs; this runner never reads DATABASE_URL or DIRECT_URL.
ACCOUNT_MIGRATION_DATABASE_URL=
# Set only for an explicitly verified isolated remote test database.
ACCOUNT_MIGRATION_ALLOW_REMOTE=
# Explicit restore target used only by db:deletions:reapply.
ACCOUNT_RESTORE_DATABASE_URL=
# Required for an intentionally verified remote restore target.
ACCOUNT_RESTORE_ALLOW_REMOTE=
